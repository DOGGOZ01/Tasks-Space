DEBUG=False
SECRET_KEY=change-me-to-a-long-random-value
JWT_SIGNING_KEY=change-me-to-a-different-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=False

# WARNING: allows <script> tags in Custom HTML/CSS blocks to actually run.
# Only for a fully trusted, single-user local instance -- see the comment
# above ALLOW_CUSTOM_SCRIPTS in tasks/settings.py before turning this on.
ALLOW_CUSTOM_SCRIPTS=False
ALLOW_PUBLIC_REGISTRATION=False

# --- Day lock: when a past daily/weekly task bucket stops accepting new tasks ---
# DAY_LOCK_MODE=local  -> locks as soon as the day/week is over in DAY_LOCK_TIMEZONE
# DAY_LOCK_MODE=global -> locks only once the day/week is over everywhere on Earth
DAY_LOCK_MODE=local
DAY_LOCK_TIMEZONE=UTC

# --- Auth throttling (requests per IP, django-rest-framework rate syntax e.g. "10/min", "100/day") ---
AUTH_LOGIN_THROTTLE_RATE=10/min
AUTH_REGISTER_THROTTLE_RATE=5/min
AUTH_REFRESH_THROTTLE_RATE=30/min

# --- AI assistant (server-shared-key mode; leave AI_ASSISTANT_ENABLED=False to keep it off) ---
AI_ASSISTANT_ENABLED=False
AI_ASSISTANT_PROVIDER=anthropic
AI_ASSISTANT_MODEL=claude-sonnet-5
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MAX_TOKENS=16000
AI_ASSISTANT_TIMEOUT_SECONDS=60
AI_CHAT_THROTTLE_RATE=20/min
MAX_AI_REQUEST_BYTES=200000

# --- Sandboxed HTML/CSS/JS render preview (Custom HTML block, board background, animation overlay) ---
RENDER_PREVIEW_TTL_SECONDS=600
MAX_RENDER_PREVIEW_REQUEST_BYTES=200000
RENDER_PREVIEW_THROTTLE_RATE=180/min

# --- Image / GIF uploads ---
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_IMAGE_DIMENSION=4000
MAX_GIF_FRAMES=300
MIN_GIF_FRAME_DURATION_MS=20

# --- Board content size limits ---
MAX_CUSTOM_HTML_LENGTH=20000
MAX_CUSTOM_CSS_LENGTH=4000
MAX_LAYOUT_JSON_BYTES=2000000
MAX_TASK_TEXT_LENGTH=500
MAX_TASKS_PER_DATE=200
MAX_TASKS_JSON_BYTES=500000
MAX_SAVED_DESIGN_NAME_LENGTH=80
MAX_SAVED_DESIGNS_PER_USER=30
