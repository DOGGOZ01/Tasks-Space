        "html": "<style>\nbody { margin: 0; font-family: \"Patrick Hand\", cursive; color: #3d3a35; }\n.card { position: fixed; top: 8px; left: 8px; width: calc(100vw - 48px); height: calc(100vh - 44px); background: #fffdf7; box-shadow: 0 10px 16px -10px rgba(70,50,20,.45); padding: 12px 16px; transform: rotate(1.5deg); }\nh2 { margin: 0 0 8px 0; font-family: \"Caveat\", cursive; font-size: 34px; font-weight: 700; }\n.grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; text-align: center; font-size: 17px; }\n.grid b { font-weight: 400; color: #e85d75; }\n.grid span { padding: 3px 0; }\n.today { border: 2px solid #e85d75; border-radius: 50%; transform: rotate(-8deg); }\n</style>\n<div class=\"card\"><h2 id=\"month\">this month</h2><div class=\"grid\" id=\"grid\"><b>M</b><b>T</b><b>W</b><b>T</b><b>F</b><b>S</b><b>S</b></div></div>\n<script>\nvar now = new Date();\nvar months = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];\ndocument.getElementById('month').textContent = months[now.getMonth()] + ' ' + now.getFullYear();\nvar gridEl = document.getElementById('grid');\nvar first = new Date(now.getFullYear(), now.getMonth(), 1);\nvar offset = (first.getDay() + 6) % 7;\nvar days = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();\nfor (var i = 0; i < offset; i++) gridEl.appendChild(document.createElement('span'));\nfor (var day = 1; day <= days; day++) {\n  var cell = document.createElement('span');\n  cell.textContent = day;\n  if (day === now.getDate()) cell.className = 'today';\n  gridEl.appendChild(cell);\n}\n</script>",
