        "html": "<style>\nbody { margin: 0; font-family: \"Patrick Hand\", cursive; color: #3d3a35; }\n.card { position: fixed; top: 8px; left: 8px; width: calc(100vw - 48px); height: calc(100vh - 36px); background: #e8f4ff; box-shadow: 0 10px 16px -10px rgba(70,50,20,.45); padding: 10px 16px; transform: rotate(-1deg); }\nh2 { margin: 0 0 4px 0; font-family: \"Caveat\", cursive; font-size: 30px; }\n.row { display: grid; grid-template-columns: 120px repeat(7, 26px); gap: 6px; align-items: center; font-size: 18px; margin: 3px 0; }\n.dot { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #3d3a35; cursor: pointer; transition: transform .15s ease; }\n.on { background: #7fb8e6; }\n.hint { font-size: 14px; opacity: .55; }\n</style>\n<div class=\"card\" id=\"card\">\n<h2>habits <span class=\"hint\">(click a circle)</span></h2>\n<div class=\"row\">💧 water<i class=\"dot on\"></i><i class=\"dot on\"></i><i class=\"dot on\"></i><i class=\"dot\"></i><i class=\"dot on\"></i><i class=\"dot\"></i><i class=\"dot\"></i></div>\n<div class=\"row\">🚶 walk<i class=\"dot on\"></i><i class=\"dot\"></i><i class=\"dot on\"></i><i class=\"dot on\"></i><i class=\"dot\"></i><i class=\"dot\"></i><i class=\"dot\"></i></div>\n<div class=\"row\">📖 read<i class=\"dot\"></i><i class=\"dot on\"></i><i class=\"dot on\"></i><i class=\"dot\"></i><i class=\"dot\"></i><i class=\"dot\"></i><i class=\"dot\"></i></div>\n<div class=\"row\">😴 8h sleep<i class=\"dot on\"></i><i class=\"dot on\"></i><i class=\"dot\"></i><i class=\"dot on\"></i><i class=\"dot on\"></i><i class=\"dot\"></i><i class=\"dot\"></i></div>\n</div>\n<script>\ndocument.getElementById('card').addEventListener('click', function (event) {\n  if (event.target.classList.contains('dot')) event.target.classList.toggle('on');\n});\n</script>",
