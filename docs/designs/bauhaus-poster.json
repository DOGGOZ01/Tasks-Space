    "html": "<style>\nbody { margin: 0; overflow: hidden; background: #efe7d6; }\n.paper { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: #efe7d6; background-image: radial-gradient(rgba(17,17,17,.07) 1px, transparent 1.2px), radial-gradient(rgba(17,17,17,.04) 1px, transparent 1.2px); background-size: 7px 7px, 13px 13px; background-position: 0 0, 3px 5px; }\n.grid { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-image: linear-gradient(90deg, rgba(17,17,17,.06) 1px, transparent 1px); background-size: 8.333vw 100%; }\n.mark { position: fixed; width: 22px; height: 22px; border: 1.5px solid #111111; border-radius: 50%; opacity: .55; }\n.mark i { position: absolute; display: block; background: #111111; }\n.h { left: -8px; top: 10px; width: 38px; height: 1.5px; }\n.v { top: -8px; left: 10px; width: 1.5px; height: 38px; }\n.m1 { top: 18px; left: 18px; } .m2 { top: 18px; right: 18px; } .m3 { bottom: 18px; left: 18px; } .m4 { bottom: 18px; right: 18px; }\n.meta { position: fixed; font-family: \"IBM Plex Mono\", monospace; font-size: 11px; letter-spacing: .25em; color: rgba(17,17,17,.55); }\n.t1 { bottom: 150px; left: 52px; } .t2 { bottom: 130px; left: 52px; }\n.ring { position: fixed; right: -6vmin; top: -22vmin; width: 66vmin; height: 66vmin; border-radius: 50%; border: 2px solid #111111; }\n.sun { position: fixed; right: -14vmin; top: -30vmin; width: 66vmin; height: 66vmin; border-radius: 50%; background: #e63b2e; animation: breathe 9s ease-in-out infinite; }\n@keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.04); } }\n.fig { position: fixed; right: 4vmin; top: 40vmin; font-family: \"IBM Plex Mono\", monospace; font-size: 12px; letter-spacing: .3em; color: #111111; }\n.q { position: fixed; right: -48vmin; bottom: -48vmin; width: 96vmin; height: 96vmin; border-radius: 50%; background: #f6c026; }\n.star { position: fixed; right: 4vmin; bottom: 46vmin; font-size: 64px; color: #111111; animation: spin 14s linear infinite; }\n@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }\n.band { position: fixed; left: -3vw; bottom: 34px; width: 106vw; height: 64px; background: #111111; transform: rotate(-2deg); overflow: hidden; display: flex; align-items: center; }\n.track { display: flex; white-space: nowrap; animation: run 26s linear infinite; }\n.track span { font-family: \"Anton\", sans-serif; font-size: 40px; letter-spacing: .04em; color: #efe7d6; padding: 0 0 0 24px; }\n.track b { font-weight: 400; color: #f6c026; }\n.track i { font-style: normal; color: #e63b2e; }\n@keyframes run { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n</style>\n<div class=\"paper\"></div><div class=\"grid\"></div>\n<div class=\"ring\"></div><div class=\"sun\"></div><div class=\"fig\">FIG. 1 — THE DAY</div>\n<div class=\"q\"></div><div class=\"star\">✺</div>\n<div class=\"band\"><div class=\"track\">\n<span>DESIGN YOUR DAY <b>✦</b> DO THE WORK <i>✦</i> TICK IT OFF <b>✦</b> REST <i>✦</i> REPEAT <b>✦</b></span>\n<span>DESIGN YOUR DAY <b>✦</b> DO THE WORK <i>✦</i> TICK IT OFF <b>✦</b> REST <i>✦</i> REPEAT <b>✦</b></span>\n<span>DESIGN YOUR DAY <b>✦</b> DO THE WORK <i>✦</i> TICK IT OFF <b>✦</b> REST <i>✦</i> REPEAT <b>✦</b></span>\n<span>DESIGN YOUR DAY <b>✦</b> DO THE WORK <i>✦</i> TICK IT OFF <b>✦</b> REST <i>✦</i> REPEAT <b>✦</b></span>\n</div></div>\n<div class=\"mark m1\"><i class=\"h\"></i><i class=\"v\"></i></div>\n<div class=\"mark m2\"><i class=\"h\"></i><i class=\"v\"></i></div>\n<div class=\"mark m3\"><i class=\"h\"></i><i class=\"v\"></i></div>\n<div class=\"mark m4\"><i class=\"h\"></i><i class=\"v\"></i></div>\n<div class=\"meta t1\">TASKS SPACE — ISSUE Nº 01</div>\n<div class=\"meta t2\">PRINTED IN YOUR BROWSER</div>"
