nt = months[d.getMonth()];\ndocument.getElementById('year').textContent = String(d.getFullYear()) + ' — WEEK ' + Math.ceil(((d - new Date(d.getFullYear(), 0, 1)) / 86400000 + new Date(d.getFullYear(), 0, 1).getDay() + 1) / 7);\n</script>",
